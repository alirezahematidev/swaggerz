{
  "name": "swaggerz",
  "version": "0.2.1",
  "description": "Generate fully typed, documented, tree-shakeable API clients from Swagger 2.0 and OpenAPI 3.0/3.1/3.2 specifications.",
  "keywords": [
    "openapi",
    "swagger",
    "codegen",
    "typescript",
    "api-client",
    "fetch",
    "axios",
    "react-query",
    "tanstack-query",
    "tree-shaking"
  ],
  "license": "MIT",
  "author": {
    "name": "Alireza Hemati",
    "email": "alirezahematideveloper71@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alirezahematidev/swaggerz.git"
  },
  "bugs": {
    "url": "https://github.com/alirezahematidev/swaggerz/issues"
  },
  "homepage": "https://swaggerz.dev",
  "type": "module",
  "sideEffects": [
    "./dist/cli/bin.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/integrations/vite.d.ts",
      "default": "./dist/integrations/vite.js"
    },
    "./astro": {
      "types": "./dist/integrations/astro.d.ts",
      "default": "./dist/integrations/astro.js"
    },
    "./next": {
      "types": "./dist/integrations/next.d.ts",
      "default": "./dist/integrations/next.js"
    },
    "./config.schema.json": "./config.schema.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "swaggerz": "./dist/cli/bin.js",
    "sz": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "assets",
    "config.schema.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:assets": "node scripts/build-assets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/templates/tsconfig.json --noEmit && tsc -p src/dashboard/client/tsconfig.json --noEmit && tsc -p tests/integration/dashboard/tsconfig.json --noEmit",
    "lint": "oxlint --ignore-pattern \"website/**\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:pack": "node scripts/verify-pack.ts",
    "test:smoke": "node dist/cli/bin.js generate --config tests/smoke/swaggerz.config.mjs && node tests/smoke/runtime.mjs",
    "test:runtimes": "node scripts/runtimes.ts",
    "bench": "node scripts/bench.ts",
    "example": "node scripts/example.ts",
    "example:react-query": "node scripts/example.ts react-query",
    "example:node-javascript": "node scripts/example.ts node-javascript",
    "example:custom-plugin": "node scripts/example.ts custom-plugin",
    "example:vue-query": "node scripts/example.ts vue-query",
    "example:svelte-query": "node scripts/example.ts svelte-query",
    "example:solid-query": "node scripts/example.ts solid-query",
    "example:swr": "node scripts/example.ts swr",
    "example:astro": "node scripts/example.ts astro",
    "example:next": "node scripts/example.ts next",
    "examples:check": "node scripts/example.ts all check",
    "examples:browsers": "node scripts/examples-browsers.ts",
    "website:dev": "pnpm --filter swaggerz-website run dev",
    "website:build": "pnpm --filter swaggerz-website run build",
    "website:check": "pnpm --filter swaggerz-website run check",
    "website:test": "pnpm --filter swaggerz-website run test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "prepare": "husky",
    "prepack": "node scripts/build.ts",
    "compat": "node scripts/compat.ts",
    "corpus": "node scripts/corpus.ts"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.0",
    "@tanstack/solid-query": "^5.104.5",
    "@tanstack/svelte-query": "^6.3.5",
    "@tanstack/vue-query": "^5.104.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "arktype": "^2.2.9",
    "astro": "^7.4.2",
    "axios": "^1.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esbuild": "^0.28.0",
    "fast-check": "^4.10.2",
    "get-nonce": "^1.0.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "lucide-react": "^1.59.0",
    "msw": "^3.0.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "radix-ui": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "release-it": "^21.1.0",
    "rollup": "^4.60.0",
    "solid-js": "^1.9.17",
    "svelte": "^5.57.2",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "valibot": "^1.5.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.44",
    "webpack": "^5.112.0",
    "zod": "^4.6.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "optionalDependencies": {
    "oxc-parser": "^0.155.0",
    "oxc-resolver": "^11.24.0"
  }
}
