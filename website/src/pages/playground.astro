---
/** The playground page: the compiler in the browser, at full width. */
import Editorial from '../layouts/Editorial.astro';
import Playground from '../playground/Playground.tsx';
---

<Editorial
  title="Playground · swaggerz"
  description="Paste a Swagger or OpenAPI document and see the client swaggerz generates for it, compiled in your browser."
  wide
  current="playground"
>
  <div class="playground-page">
    <header class="playground-intro">
      <h1>Playground</h1>
      <p>
        The compiler runs in your browser: the specification never leaves it. Links you share carry it
        in the address's fragment, which is not sent to any server.
      </p>
    </header>
    <noscript>
      <p class="playground-noscript">The playground needs JavaScript: it runs the compiler in a Web Worker.</p>
    </noscript>
    <Playground client:only="react" />
  </div>
</Editorial>

<style>
  .playground-page {
    display: flex;
    flex-direction: column;
    height: calc(100dvh - 4rem);
    min-height: 36rem;
  }
  .playground-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
    padding: 0.85rem 1.25rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--text-strong);
  }
  .playground-intro p {
    font-size: 0.88rem;
    color: var(--muted-foreground);
  }
  .playground-noscript {
    padding: 2rem 1.25rem;
  }
  .playground-page > :global(astro-island) {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }
</style>
