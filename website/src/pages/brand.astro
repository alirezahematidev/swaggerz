---
/** The brand: logo files to download and the rules for using them, from brand/README.md. */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getEntry, render } from 'astro:content';
import brand from '../generated/brand.json';
import { REPOSITORY } from '../site.ts';

const entry = await getEntry('brand', 'brand');
if (entry === undefined) throw new Error('brand/README.md was not loaded.');
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const dark = (name: string): boolean => name.includes('dark') || name === 'file-icon.svg';
const size = (bytes: number): string => (bytes < 1000 ? `${bytes} B` : `${Math.round(bytes / 1000)} kB`);
---

<StarlightPage
  frontmatter={{
    title: 'Brand',
    description: 'The swaggerz mark, wordmark and logotype, and how to use them.',
    editUrl: `${REPOSITORY.url}/edit/${REPOSITORY.branch}/brand/README.md`,
  }}
  headings={[{ depth: 2, slug: 'files', text: 'Files' }, ...headings]}
>
  <div class="sl-heading-wrapper level-h2"><h2 id="files">Files</h2></div>
  <ul class="brand-files not-content">
    {
      brand.files.map((file) => (
        <li class:list={{ 'on-dark': dark(file.name) }}>
          <a href={`${base}brand/${file.name}`} download>
            <span class="brand-preview">
              <img src={`${base}brand/${file.name}`} alt="" loading="lazy" />
            </span>
            <span class="brand-name">{file.name}</span>
            <span class="brand-size">{size(file.bytes)}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <Content />
</StarlightPage>

<style>
  .brand-files {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .brand-files a {
    display: grid;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--text-strong);
  }
  .brand-preview {
    display: grid;
    place-items: center;
    height: 7.5rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #f6f2ea;
  }
  .on-dark .brand-preview {
    background: #141311;
  }
  .brand-preview img {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
  }
  .brand-name {
    font-family: var(--font-code);
    font-size: 0.8rem;
  }
  .brand-size {
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }
  .brand-files a:hover .brand-preview {
    border-color: var(--marigold);
  }
</style>
