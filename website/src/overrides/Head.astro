---
/**
 * Starlight's head, plus preloads for the Latin subsets of the three fonts, and `noindex` on the
 * snapshots of releases.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import sans from '../../../src/dashboard/client/fonts/figtree-latin-wght-normal.woff2?url';
import serif from '../../../src/dashboard/client/fonts/fraunces-latin-full-normal.woff2?url';
import mono from '../../../src/dashboard/client/fonts/spline-sans-mono-latin-wght-normal.woff2?url';
import { SNAPSHOT } from '../versions.ts';

// Social cards are generated per page (scripts/data/og.ts); networks need absolute URLs, so the
// image is only declared when the site's URL is configured.
const { entry } = Astro.locals.starlightRoute;
const site = Astro.site;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const image = site === undefined ? undefined : new URL(`${base}og/${entry.id === '' ? 'index' : entry.id}.png`, site).href;
---

<Default />
{/* Snapshots of releases stay out of search results: the latest docs are the ones to find. */}
{SNAPSHOT && <meta name="robots" content="noindex" />}
{image !== undefined && <meta property="og:image" content={image} />}
{image !== undefined && <meta property="og:image:width" content="1200" />}
{image !== undefined && <meta property="og:image:height" content="630" />}
{image !== undefined && <meta name="twitter:image" content={image} />}
<link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
