---
/**
 * Open Graph and Twitter card tags for pages outside the docs (Starlight writes its own). The
 * image is only declared when the site's URL is known, because social networks need an absolute
 * URL.
 */
interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = 'og/index.png' } = Astro.props;
const site = Astro.site;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const imageUrl = site === undefined ? undefined : new URL(`${base}${image}`, site).href;
const pageUrl = site === undefined ? undefined : new URL(Astro.url.pathname, site).href;
---

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="swaggerz" />
{pageUrl !== undefined && <link rel="canonical" href={pageUrl} />}
{pageUrl !== undefined && <meta property="og:url" content={pageUrl} />}
{imageUrl !== undefined && <meta property="og:image" content={imageUrl} />}
{imageUrl !== undefined && <meta property="og:image:width" content="1200" />}
{imageUrl !== undefined && <meta property="og:image:height" content="630" />}
<meta name="twitter:card" content={imageUrl === undefined ? 'summary' : 'summary_large_image'} />
