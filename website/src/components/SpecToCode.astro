---
/**
 * A specification beside the code swaggerz generates for it (src/generated/twins.json, produced
 * by compiling website/twins at build time). Hovering a line highlights its counterpart on the
 * other side. Narrow screens switch between the two sides.
 */
import { Code } from '@astrojs/starlight/components';
// Imported here too, so the panel is styled on any page (docs pages also get it from Starlight).
import '../styles/twin.css';
import build from '../generated/build.json';
import twins from '../generated/twins.json';

interface Props {
  id: string;
}

const { id } = Astro.props;
const twin = (twins as Record<string, (typeof twins)[keyof typeof twins]>)[id];
if (twin === undefined) throw new Error(`Unknown twin "${id}" (see website/twins/twins.ts).`);
// One twin of a kind per page, so its id is enough to keep element ids unique.
const uid = `twin-${id}`;
// A specification of one file needs a label, not a row of tabs.
const single = twin.spec.length === 1;
const config = 'config' in twin && typeof twin.config === 'string' ? twin.config : undefined;
---

<figure class="twin not-content" data-twin={id} data-side="spec">
  <div class="twin-switch" role="tablist" aria-label="Side">
    <button type="button" role="tab" aria-selected="true" data-side-tab="spec">Specification</button>
    <button type="button" role="tab" aria-selected="false" data-side-tab="code">Generated</button>
  </div>
  <div class="twin-panes">
    <section class="twin-pane" data-pane="spec" aria-label="Specification">
      <div class="twin-bar">
        {
          single ? (
            <span class="twin-label" id={`${uid}-spec-tab-0`}>
              {twin.spec[0]?.name}
            </span>
          ) : (
            <div class="twin-tabs" role="tablist" aria-label="Specification files">
              {twin.spec.map((file, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`${uid}-spec-tab-${index}`}
                  aria-controls={`${uid}-spec-${index}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                >
                  {file.name}
                </button>
              ))}
            </div>
          )
        }
      </div>
      {
        twin.spec.map((file, index) => (
          <div
            class="twin-panel"
            role={single ? 'region' : 'tabpanel'}
            id={`${uid}-spec-${index}`}
            aria-labelledby={`${uid}-spec-tab-${index}`}
            data-active={index === 0 ? '' : undefined}
            data-primary={index === 0 ? '' : undefined}
            tabindex="0"
          >
            <Code code={file.code} lang={file.language} />
          </div>
        ))
      }
    </section>
    <section class="twin-pane" data-pane="code" aria-label="Generated code">
      <div class="twin-bar">
        <div class="twin-tabs" role="tablist" aria-label="Generated files">
        {
          twin.tabs.map((tab, index) => (
            <button
              type="button"
              role="tab"
              id={`${uid}-code-tab-${index}`}
              aria-controls={`${uid}-code-${index}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
            >
              {tab.label}
            </button>
          ))
        }
        </div>
        {/* The selected file's path; twin.ts keeps it in step with the tabs. */}
        <span class="twin-path" aria-hidden="true" data-twin-path>{twin.tabs[0]?.file}</span>
      </div>
      {
        twin.tabs.map((tab, index) => (
          <div
            class="twin-panel"
            role="tabpanel"
            id={`${uid}-code-${index}`}
            aria-labelledby={`${uid}-code-tab-${index}`}
            data-active={index === 0 ? '' : undefined}
            data-pairs={JSON.stringify(tab.pairs)}
            data-file={tab.file}
            tabindex="0"
          >
            <p class="twin-file">{tab.file}</p>
            <Code code={tab.code} lang={tab.language} />
          </div>
        ))
      }
    </section>
  </div>
  <figcaption>
    <span>
      Generated by swaggerz {build.version}{
        config !== undefined && (
          <>
            {' '}with <code>{config}</code>
          </>
        )
      }, at build time.
    </span>
    <span class="twin-hint" aria-hidden="true">Hover a line to find its counterpart.</span>
    <span class="twin-status" aria-hidden="true"></span>
  </figcaption>
</figure>

<script>
  import { setUpTwins } from '../scripts/twin.ts';

  setUpTwins();
</script>
