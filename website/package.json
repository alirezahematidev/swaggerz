{
  "name": "swaggerz-website",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "node scripts/data.ts",
    "samples": "node scripts/samples.ts",
    "dev": "node scripts/data.ts && astro dev",
    "build": "pnpm --dir .. build && node scripts/data.ts && node scripts/samples.ts && astro build && node scripts/check-links.ts",
    "build:site": "astro build",
    "links": "node scripts/check-links.ts",
    "check": "node scripts/contrast.ts && astro check && oxlint --config ../.oxlintrc.json .",
    "preview": "astro preview",
    "test": "playwright test",
    "test:gates": "playwright test tests/accessibility.spec.ts tests/security.spec.ts tests/budgets.spec.ts tests/interaction.spec.ts tests/playground.spec.ts",
    "test:visual": "playwright test tests/visual.spec.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@capsizecss/core": "4.1.3",
    "@capsizecss/metrics": "4.4.0",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "astro-expressive-code": "0.44.3",
    "esbuild": "^0.28.2",
    "fontkit": "2.0.4",
    "sharp": "0.35.5",
    "swaggerz": "workspace:*",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  }
}
