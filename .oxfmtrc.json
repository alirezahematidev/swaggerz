{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "assets",
    "coverage",
    "fixtures",
    "tests/.output",
    "tests/**/__snapshots__",
    "examples/**/src/generated",
    "examples/**/dist",
    "CHANGELOG.md",
    ".tmp",
    ".bench",
    ".compat",
    ".runtimes",
    ".corpus",
    "marketing",
    "config.schema.json",
    "pnpm-lock.yaml",
    "website/dist",
    "website/.astro",
    "website/.cache",
    "website/.measurements",
    "website/src/generated",
    "website/samples/*/generated",
    "website/samples/.extracted",
    "website/public/brand",
    "website/public/og",
    "website/test-results",
    "website/playwright-report",
    "website/tests/__screenshots__"
  ]
}
